{
  "name": "aether-writer",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first desktop-grade writing workspace for novels, screenplays and long-form manuscripts.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:storage": "node --experimental-strip-types --test tests/storage/LocalStorageAdapter.contract.test.js tests/storage/IndexedDbStorageAdapter.migration.test.js tests/storage/BackupManager.test.js tests/storage/BackupReminder.test.js tests/utils/templates.test.js tests/utils/pageLayout.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-font-family": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^0.546.0",
    "pagedjs": "^0.4.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
